# ── Supabase (proyecto público) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Seed del panel admin (solo scripts de servidor, nunca en el frontend) ───────
# Encuéntrala en: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Contraseñas de los dentistas de desarrollo (mínimo 8 caracteres)
SEED_DENTIST_1_PASSWORD=
SEED_DENTIST_2_PASSWORD=
SEED_DENTIST_3_PASSWORD=
